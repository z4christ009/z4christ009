#!/usr/bin/env bash
# ============================================================
#  Maps Lead Center - START EVERYTHING (macOS double-click)
#
#  Double-click this file to launch. It opens Terminal, installs
#  what's needed on the first run (takes a few minutes the very
#  first time), starts the control center, and opens the website
#  in your browser at http://localhost:8765
#
#  If double-clicking shows a security warning the first time:
#  right-click this file -> Open -> Open.
# ============================================================
cd "$(dirname "$0")"
bash ./start.sh
